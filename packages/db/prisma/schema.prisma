generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum AuthProvider {
  email
  google
}

enum SubscriptionTier {
  free
  plus
}

enum MessageSender {
  user
  companion
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled
  unpaid
}

enum TransactionType {
  subscription
  one_time
}

enum TransactionStatus {
  pending
  succeeded
  failed
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  passwordHash          String?          @map("password_hash")
  displayName           String?          @map("display_name")
  authProvider          AuthProvider     @map("auth_provider")
  createdAt             DateTime         @default(now()) @map("created_at")
  subscriptionTier      SubscriptionTier @default(free) @map("subscription_tier")
  creditsBalance        Int              @default(0) @map("credits_balance")
  onboardingCompletedAt DateTime?        @map("onboarding_completed_at")
  deletedAt             DateTime?        @map("deleted_at")

  relationships UserCompanionRelationship[]
  subscriptions Subscription[]
  transactions  Transaction[]

  @@map("users")
}

model Companion {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  avatarUrl         String?  @map("avatar_url")
  shortBio          String   @map("short_bio")
  personalityPrompt String   @map("personality_prompt") @db.Text
  tags              String[]
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  relationships UserCompanionRelationship[]

  @@map("companions")
}

model UserCompanionRelationship {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  companionId      String   @map("companion_id")
  nicknameForUser  String?  @map("nickname_for_user")
  relationshipStage String  @default("new") @map("relationship_stage")
  createdAt        DateTime @default(now()) @map("created_at")
  lastInteractedAt DateTime @default(now()) @map("last_interacted_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion     Companion      @relation(fields: [companionId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  memories      Memory[]

  @@unique([userId, companionId])
  @@index([userId])
  @@map("user_companion_relationships")
}

model Conversation {
  id                           String   @id @default(uuid())
  userCompanionRelationshipId  String   @map("user_companion_relationship_id")
  createdAt                    DateTime @default(now()) @map("created_at")

  relationship UserCompanionRelationship @relation(fields: [userCompanionRelationshipId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userCompanionRelationshipId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  sender         MessageSender
  content        String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  flagged        Boolean       @default(false)
  tokenCount     Int?          @map("token_count")

  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  moderationFlags  ModerationFlag[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id                          String   @id @default(uuid())
  userCompanionRelationshipId String   @map("user_companion_relationship_id")
  factText                    String   @map("fact_text") @db.Text
  /// Embedding dimension is a Phase 1 decision (model choice). 1536 is a placeholder.
  embedding                   Unsupported("vector(1536)")
  importanceScore             Float    @default(0) @map("importance_score")
  createdAt                   DateTime @default(now()) @map("created_at")
  lastReferencedAt            DateTime? @map("last_referenced_at")

  relationship UserCompanionRelationship @relation(fields: [userCompanionRelationshipId], references: [id], onDelete: Cascade)

  @@index([userCompanionRelationshipId])
  @@map("memories")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  tier                 SubscriptionTier
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Transaction {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  stripePaymentIntentId String?           @unique @map("stripe_payment_intent_id")
  amount                Int
  type                  TransactionType
  status                TransactionStatus
  createdAt             DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

model ModerationFlag {
  id          String   @id @default(uuid())
  messageId   String   @map("message_id")
  reason      String
  actionTaken String   @map("action_taken")
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("moderation_flags")
}
